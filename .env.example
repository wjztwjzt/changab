# ============================================================
# Telegram API 凭证
# 获取地址：https://my.telegram.org → API development tools
# 注意：API_HASH 等同于账号密码，真实值只写在本地 .env 里，不要提交
# ============================================================
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# ============================================================
# 会话文件名（首次运行会生成 <SESSION_NAME>.session）
# 登录成功后这个文件代表你的登录状态，同样不要提交
# ============================================================
SESSION_NAME=channel_copy

# ============================================================
# 源频道（A）和目标频道（B）
# 支持三种写法：
#   @username        公开频道
#   https://t.me/xxx 公开链接
#   -1001234567890   数字 ID（私有频道用这个）
# ============================================================
SOURCE_CHANNEL=@source_channel
TARGET_CHANNEL=@target_channel

# ============================================================
# 时区：用于解释下面的日期
# 中国用 Asia/Shanghai，UTC 用 UTC
# ============================================================
TIMEZONE=Asia/Shanghai

# ============================================================
# 发送间隔（秒）：每条消息之间的等待时间
# 太小容易触发 Telegram 限流（FloodWait），建议不低于 1.0
# ============================================================
SEND_DELAY=1.0

# ============================================================
# 末尾追加的联系链接
# 会在每条消息（含相册）的最后加上可点击的 CONTACT_LABEL
# ============================================================
CONTACT_LABEL=投稿联系
CONTACT_URL=https://t.me/abc

# ============================================================
# 复制模式：二选一
# 优先级：MESSAGE_IDS 非空 → 走指定 ID 模式
#         MESSAGE_IDS 为空 → 走日期范围模式
# ============================================================

# ---------- 模式一：指定消息 ID ----------
# 只复制这几条消息，忽略下面的日期配置
# 多个用英文逗号分隔，不要有空格
# 如果某个 ID 属于相册，会自动展开整个相册
MESSAGE_IDS=

# ---------- 模式二：日期范围 ----------
# 方式 A：指定起止日期（END_DATE 当天也包含，可留空）
START_DATE=2025-05-20
END_DATE=
# 方式 B：复制最近 N 天（START_DATE 和 END_DATE 都留空时生效）
LAST_DAYS=
